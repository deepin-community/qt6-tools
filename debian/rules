#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

# Bootstrap pass on sw64: qdoc-qt6 for sw64 is not published yet, so the
# documentation build (and its qdoc build-deps) must be skipped there.
# Documentation packages are Architecture: all and are built on amd64.
ifeq ($(DEB_HOST_ARCH),sw64)
DEB_BUILD_PROFILES := $(filter-out nodoc,$(DEB_BUILD_PROFILES)) nodoc
endif
export DEB_BUILD_PROFILES

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

export LLVM_INSTALL_DIR := $(shell llvm-config --prefix)

# enable ccache with corresponding build-profile
ifneq ($(filter ccache,$(DEB_BUILD_PROFILES)),)
	extra_cmake_args += -DQT_USE_CCACHE=ON
endif

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- \
		--log-level=STATUS \
		-DCMAKE_LIBRARY_PATH=$(DEB_HOST_MULTIARCH) \
		-DCMAKE_SKIP_INSTALL_RPATH=ON \
		-DINSTALL_PUBLICBINDIR=/usr/bin \
		-DQT_FEATURE_kmap2qmap=OFF \
		$(extra_cmake_args)

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info

ifeq (,$(filter nodoc,$(DEB_BUILD_PROFILES)))
override_dh_auto_build-indep:
	dh_auto_build -- docs
endif

ifeq (,$(filter nodoc,$(DEB_BUILD_PROFILES)))
override_dh_auto_install-indep:
	DESTDIR=$(CURDIR)/debian/tmp dh_auto_build -- install_docs
	# Remove build path from index files.
	find $(CURDIR)/debian/tmp/usr/share/qt6/doc -type f -name *.index -exec \
               sed -i 's@$(CURDIR)/@@g' {} \;
endif

execute_after_dh_auto_install-arch:
	# Reproducible builds: remove build paths from .prl files
	sed -i -e '/^QMAKE_PRL_BUILD_DIR/d' debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/libQt6*.prl
	# Reproducible builds: remove kernel version from build artifacts
	sed -i '/^[[:space:]]*"version":.*deb/d' debian/tmp/usr/lib/${DEB_HOST_MULTIARCH}/qt6/modules/*.json
